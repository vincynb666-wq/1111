<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sun Inns Mini Check-In Kiosk</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9; 
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 400px;
            background: white;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            position: relative;
        }

        .screen { display: none; width: 100%; flex-direction: column; align-items: center; gap: 15px; }
        .screen.active { display: flex; }

        .header-logo {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 5px;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .header-logo img { width: 120px; height: auto; }

        h2 { margin: 10px 0; color: #333; }
        p { color: #666; }

        button {
            width: 100%; padding: 15px; min-height: 60px;
            background-color: #0056b3; color: white;
            border: none; border-radius: 12px; font-size: 16px;
            cursor: pointer; transition: background-color 0.3s; margin-top: 5px;
        }
        button:hover { background-color: #004494; }

        .btn-danger { background-color: #dc3545; }
        .btn-danger:hover { background-color: #c82333; }
        .btn-success { background-color: #28a745; }
        .btn-success:hover { background-color: #218838; }
        .btn-secondary { background-color: #6c757d; }
        .btn-secondary:hover { background-color: #5a6268; }

        input { width: 90%; padding: 15px; border: 1px solid #ccc; border-radius: 12px; font-size: 16px; margin-bottom: 10px; }

        table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 14px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: center; }
        th { background-color: #FFCC00; color: #333; font-weight: bold; }
        tr:nth-child(odd) { background-color: #ffffff; }
        tr:nth-child(even) { background-color: #d3d3d3; }

        #lang-toggle {
            position: absolute; top: 20px; right: 20px;
            width: auto; min-height: auto; padding: 8px 15px;
            background-color: #6c757d; font-size: 14px; z-index: 10;
        }
        #lang-toggle:hover { background-color: #5a6268; }

        #admin-link {
            position: absolute; top: 20px; left: 20px;
            font-size: 12px; color: #999; text-decoration: none; cursor: pointer; z-index: 10;
        }
        #admin-link:hover { color: #333; }

        .error-msg { color: red; font-size: 14px; display: none; }
        .price-breakdown { font-size: 14px; color: #555; margin-top: 5px; }
        #checkout-input { width: 80%; font-size: 20px; text-align: center; margin-top: 10px; }

        #receipt-box {
            width: 100%;
            background: #f9f9f9;
            border: 2px dashed #ccc;
            border-radius: 10px;
            padding: 15px;
            margin-top: 10px;
            text-align: left;
            font-size: 14px;
        }
        #receipt-box div { margin-bottom: 8px; }
        #receipt-total {
            border-top: 1px solid #ccc;
            padding-top: 10px;
            margin-top: 10px;
            font-size: 18px;
            font-weight: bold;
            color: #dc3545;
            text-align: center;
        }
    </style>
</head>
<body>
    <button id="lang-toggle">BM / EN</button>
    <a id="admin-link" onclick="showAdminPanel()">Admin Panel</a>

    <div class="container" id="app-container">
        <div class="header-logo">
            <img src="logo.png" alt="Sun Inns Logo" onclick="switchScreen('screen-welcome')">
        </div>

        <div id="screen-welcome" class="screen active">
            <p id="welcome-text" style="font-size: 18px; margin-top: 10px;">Welcome to our mini check-in kiosk.</p>
            <button onclick="switchScreen('screen-booking')" id="welcome-btn" class="btn-success">Check-In </button>
            <button onclick="switchScreen('screen-checkout')" id="checkout-btn" class="btn-danger">Check-Out</button>
        </div>

        <div id="screen-booking" class="screen">
            <h2 id="booking-title">Find Your Booking</h2>
            <input type="text" id="booking-input" placeholder="Enter Room Number">
            <button onclick="searchBooking()" id="search-btn">Search</button>
            <p id="error-msg" class="error-msg">Invalid booking number.</p>
            <button onclick="switchScreen('screen-welcome')" class="btn-secondary">Back</button>
        </div>

        <div id="screen-details" class="screen">
            <h2 id="details-title">Room Details</h2>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th id="th-guests">Guests</th>
                        <th id="th-room">Room No.</th>
                        <th id="th-type">Type</th>
                        <th id="th-nights">Nights</th>
                        <th id="th-rate">Rate</th>
                    </tr>
                </thead>
                <tbody id="details-body"></tbody>
            </table>
            <button onclick="confirmCheckIn()" id="confirm-btn">Confirm Check-in</button>
            <button onclick="switchScreen('screen-booking')" class="btn-secondary">Back</button>
        </div>

        <div id="screen-confirmation" class="screen">
            <h2 id="conf-title">Check-in Successful!</h2>
            <p id="conf-msg">Thank you for choosing Sun Inns.</p>
            <p><strong id="total-price-label">Total:</strong> <span id="total-price">RM0.00</span></p>
            <div id="price-detail" class="price-breakdown"></div>
            <button onclick="finishCheckIn()" id="done-btn">Done</button>
        </div>

        <div id="screen-checkout" class="screen">
            <h2 id="co-title">Check-Out </h2>
            <p id="co-text">Please enter the room number to check out.</p>
            <input type="text" id="checkout-input" placeholder="Enter Room Number">
            <p id="co-error-msg" class="error-msg">Room not checked in or not found.</p>
            <button onclick="processCheckOut()" id="co-btn" class="btn-danger">Confirm Check-Out</button>
            <button onclick="switchScreen('screen-welcome')" class="btn-secondary">Back</button>
        </div>

        <div id="screen-receipt" class="screen">
            <h2 id="receipt-title">Check-Out Receipt</h2>
            <div id="receipt-box">
                <div id="receipt-room"></div>
                <div id="receipt-guest"></div>
                <div id="receipt-checkin"></div>
                <div id="receipt-checkout"></div>
                <div id="receipt-duration"></div>
                <div id="receipt-cost"></div>
                <div id="receipt-fee"></div>
                <div id="receipt-total"></div>
            </div>
            <button onclick="finishCheckOut()" id="receipt-done-btn" class="btn-success">Done</button>
        </div>

        <div id="screen-admin" class="screen">
            <h2>Admin Panel</h2>
            <p>Currently Checked In: <strong id="admin-count">0</strong></p>
            <div id="admin-list" style="width:100%; text-align:left; font-size:14px; margin-top:10px; max-height:300px; overflow-y:auto; border:1px solid #ddd; padding:10px; border-radius:5px;"></div>
            <button onclick="switchScreen('screen-welcome')" class="btn-secondary">Back to Start</button>
        </div>
    </div>

    <script>
        let bookings = [
            { id: 101, name: "Mr. Tan", guests: 2, roomNo: 101, type: "Deluxe", nights: 2, rate: 150 },
            { id: 102, name: "Ms. Lee", guests: 1, roomNo: 102, type: "Single", nights: 1, rate: 100 },
            { id: 103, name: "Mr. Wong", guests: 4, roomNo: 103, type: "Family", nights: 3, rate: 250 },
            { id: 104, name: "Ms. Lim", guests: 2, roomNo: 104, type: "Standard", nights: 1, rate: 120 },
            { id: 105, name: "Mr. Kevin", guests: 3, roomNo: 105, type: "Suite", nights: 2, rate: 200 }
        ];

        let checkedInRooms = JSON.parse(localStorage.getItem('sunInnsCheckedIn')) || [];

        const translations = {
            'en': {
                'welcome-text': 'Welcome to our mini check-in kiosk.', 'welcome-btn': 'Check-In', 'checkout-btn': 'Check-Out',
                'booking-title': 'Find Your Booking', 'search-btn': 'Search', 'details-title': 'Room Details',
                'th-guests': 'Guests', 'th-room': 'Room No.', 'th-type': 'Type', 'th-nights': 'Nights', 'th-rate': 'Rate',
                'confirm-btn': 'Confirm Check-in', 'conf-title': 'Check-in Successful!', 'conf-msg': 'Thank you for choosing Sun Inns.',
                'total-price-label': 'Total', 'done-btn': 'Done', 'error-msg': 'Invalid booking number.',
                'not-found-checkin': 'Room not checked in or not found.',
                'room-occupied': 'This room is already checked in. Please check out first.',
                'co-title': 'Check-Out', 'co-text': 'Please enter the room number to check out.',
                'co-btn': 'Confirm Check-Out', 'receipt-title': 'Check-Out Receipt', 'receipt-done-btn': 'Done'
            },
            'bm': {
                'welcome-text': 'Selamat datang ke kiosk daftar masuk mini kami.', 'welcome-btn': 'Daftar Masuk', 'checkout-btn': 'Daftar Keluar',
                'booking-title': 'Cari Tempahan Anda', 'search-btn': 'Cari', 'details-title': 'Butiran Bilik',
                'th-guests': 'Tetamu', 'th-room': 'No. Bilik', 'th-type': 'Jenis', 'th-nights': 'Malam', 'th-rate': 'Kadar',
                'confirm-btn': 'Sahkan Daftar Masuk', 'conf-title': 'Daftar Masuk Berjaya!', 'conf-msg': 'Terima kasih memilih Sun Inns.',
                'total-price-label': 'Jumlah', 'done-btn': 'Selesai', 'error-msg': 'Nombor tempahan tidak sah.',
                'not-found-checkin': 'Bilik belum daftar masuk atau tidak dijumpai.',
                'room-occupied': 'Bilik ini telah didaftar masuk. Sila daftar keluar dahulu.',
                'co-title': 'Daftar Keluar', 'co-text': 'Sila masukkan nombor bilik untuk daftar keluar.',
                'co-btn': 'Sahkan Daftar Keluar', 'receipt-title': 'Resit Daftar Keluar', 'receipt-done-btn': 'Selesai'
            }
        };
        let currentLang = 'en';

        function switchScreen(screenId) {
            document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
            document.getElementById('error-msg').style.display = 'none';
            document.getElementById('co-error-msg').style.display = 'none'; 
            if(screenId === 'screen-checkout') document.getElementById('checkout-input').value = ''; 
            localStorage.setItem('sunInnsCurrentScreen', screenId);
        }

        function isRoomOccupied(roomId) {
            return checkedInRooms.some(item => item.id == roomId && item.status === "Checked-In");
        }

        function searchBooking() {
            const inputVal = document.getElementById('booking-input').value;
            if (!inputVal) { showError("Please enter a room number."); return; }
            if (isRoomOccupied(inputVal)) { alert(translations[currentLang]['room-occupied']); return; }
            const booking = bookings.find(b => b.id == inputVal);
            if (booking) {
                displayDetails(booking);
                switchScreen('screen-details');
                document.getElementById('error-msg').style.display = 'none';
            } else {
                showError(translations[currentLang]['error-msg']);
            }
        }

        function showError(msg) {
            const errorEl = document.getElementById('error-msg');
            errorEl.textContent = msg;
            errorEl.style.display = 'block';
        }

        function displayDetails(booking) {
            const tbody = document.getElementById('details-body');
            tbody.innerHTML = `
                <tr>
                    <td>${booking.name}</td>
                    <td>${booking.guests}</td>
                    <td>${booking.roomNo}</td>
                    <td>${booking.type}</td>
                    <td>${booking.nights}</td>
                    <td>RM${booking.rate}</td>
                </tr>
            `;
            window.currentBooking = booking;
            localStorage.setItem('sunInnsCurrentBookingId', booking.id);
        }

        function confirmCheckIn() {
            if (window.currentBooking) {
                if (isRoomOccupied(window.currentBooking.id)) {
                    alert(translations[currentLang]['room-occupied']);
                    switchScreen('screen-booking');
                    return;
                }
                const currentTime = new Date().toISOString();
                checkedInRooms.push({
                    id: window.currentBooking.id,
                    name: window.currentBooking.name,
                    roomNo: window.currentBooking.roomNo,
                    checkInTime: currentTime,
                    status: "Checked-In" 
                });
                localStorage.setItem('sunInnsCheckedIn', JSON.stringify(checkedInRooms));

                const b = window.currentBooking;
                const grandTotal = b.nights * b.rate;
                
                localStorage.setItem('sunInnsConfirmationTotal', grandTotal.toFixed(2));
                localStorage.setItem('sunInnsConfirmationDetail', `(RM${b.rate} x ${b.nights} nights)`);

                document.getElementById('total-price').textContent = `RM${grandTotal.toFixed(2)}`;
                document.getElementById('price-detail').textContent = `(RM${b.rate} x ${b.nights} nights)`;
                switchScreen('screen-confirmation');
            }
        }

        function finishCheckIn() {
            document.getElementById('booking-input').value = '';
            window.currentBooking = null;
            localStorage.removeItem('sunInnsCurrentBookingId');
            localStorage.removeItem('sunInnsConfirmationTotal');
            localStorage.removeItem('sunInnsConfirmationDetail');
            switchScreen('screen-welcome');
        }

        function processCheckOut() {
            const roomId = document.getElementById('checkout-input').value;
            const errorEl = document.getElementById('co-error-msg');

            if (!roomId) { 
                errorEl.textContent = "Please enter a room number.";
                errorEl.style.display = 'block';
                return; 
            }

            const booking = bookings.find(b => b.id == roomId);
            if (!booking) { 
                errorEl.textContent = "Room number not found!";
                errorEl.style.display = 'block';
                return; 
            }

            const recordIndex = checkedInRooms.findIndex(item => item.id == roomId && item.status === "Checked-In");
            if (recordIndex === -1) {
                errorEl.textContent = translations[currentLang]['not-found-checkin'];
                errorEl.style.display = 'block';
                return;
            }

            const record = checkedInRooms[recordIndex];
            const checkInTime = new Date(record.checkInTime);
            const currentTime = new Date();
            
            const secondsDiff = (currentTime - checkInTime) / 1000;
            const isOvertime = secondsDiff > 300; 

            let overTimeFee = 0, overtimeText = "";
            if (isOvertime) { 
                overTimeFee = 50; 
                overtimeText = ` (Over 5 min, +RM50)`; 
            } else { 
                overtimeText = ` (Within 5 min, no extra fee)`; 
            }

            const baseRoomCost = booking.nights * booking.rate;
            const finalCost = baseRoomCost + overTimeFee;

            checkedInRooms[recordIndex].status = "Checked-Out";
            checkedInRooms[recordIndex].checkOutTime = currentTime.toISOString();
            
            localStorage.setItem('sunInnsCheckedIn', JSON.stringify(checkedInRooms));

            // 【修改】將收據內容保存到 localStorage
            const receiptData = {
                room: `Room: ${booking.roomNo} (${booking.type})`,
                guest: `Guest: ${booking.name}`,
                checkin: `Check-in Time: ${checkInTime.toLocaleString()}`,
                checkout: `Check-out Time: ${currentTime.toLocaleString()}`,
                duration: `Total Duration: ${(secondsDiff / 60).toFixed(1)} Minutes`,
                cost: `Room Cost: RM${baseRoomCost}`,
                fee: `Overtime Fee: RM${overTimeFee} ${overtimeText}`,
                total: `TOTAL PAID: RM${finalCost}`
            };
            localStorage.setItem('sunInnsLastReceipt', JSON.stringify(receiptData));

            document.getElementById('receipt-room').textContent = receiptData.room;
            document.getElementById('receipt-guest').textContent = receiptData.guest;
            document.getElementById('receipt-checkin').textContent = receiptData.checkin;
            document.getElementById('receipt-checkout').textContent = receiptData.checkout;
            document.getElementById('receipt-duration').textContent = receiptData.duration;
            document.getElementById('receipt-cost').textContent = receiptData.cost;
            document.getElementById('receipt-fee').textContent = receiptData.fee;
            document.getElementById('receipt-total').textContent = receiptData.total;

            switchScreen('screen-receipt');
        }

        function finishCheckOut() {
            localStorage.removeItem('sunInnsLastReceipt');
            switchScreen('screen-welcome');
        }

        function showAdminPanel() {
            const activeRooms = checkedInRooms.filter(item => item.status === "Checked-In");
            document.getElementById('admin-count').textContent = activeRooms.length;
            
            const listDiv = document.getElementById('admin-list');
            if (checkedInRooms.length === 0) {
                listDiv.innerHTML = "<p style='color:#999;'>No active records.</p>";
            } else {
                let html = "<ul style='list-style:none; padding:0; margin:0;'>";
                for (let i = checkedInRooms.length - 1; i >= 0; i--) {
                    const item = checkedInRooms[i];
                    const time = new Date(item.checkInTime).toLocaleString();
                    const statusColor = item.status === "Checked-In" ? "green" : "gray";
                    html += `<li style='padding: 8px 0; border-bottom: 1px solid #eee;'>
                        <strong>${item.name}</strong> (Room ${item.roomNo})<br>
                        <span style='color:#666; font-size:12px;'>Check-in: ${time} | <span style="color:${statusColor}">Status: ${item.status}</span></span>
                    </li>`;
                }
                html += "</ul>";
                listDiv.innerHTML = html;
            }
            switchScreen('screen-admin');
        }

        document.getElementById('lang-toggle').addEventListener('click', function() {
            currentLang = currentLang === 'en' ? 'bm' : 'en';
            const t = translations[currentLang];

            document.getElementById('welcome-text').textContent = t['welcome-text'];
            document.getElementById('welcome-btn').textContent = t['welcome-btn'];
            document.getElementById('checkout-btn').textContent = t['checkout-btn'];
            document.getElementById('booking-title').textContent = t['booking-title'];
            document.getElementById('search-btn').textContent = t['search-btn'];
            document.getElementById('details-title').textContent = t['details-title'];
            document.getElementById('th-guests').textContent = t['th-guests'];
            document.getElementById('th-room').textContent = t['th-room'];
            document.getElementById('th-type').textContent = t['th-type'];
            document.getElementById('th-nights').textContent = t['th-nights'];
            document.getElementById('th-rate').textContent = t['th-rate'];
            document.getElementById('confirm-btn').textContent = t['confirm-btn'];
            document.getElementById('conf-title').textContent = t['conf-title'];
            document.getElementById('conf-msg').textContent = t['conf-msg'];
            document.getElementById('total-price-label').textContent = t['total-price-label'];
            document.getElementById('done-btn').textContent = t['done-btn'];
            document.getElementById('error-msg').textContent = t['error-msg'];
            document.getElementById('co-title').textContent = t['co-title'];
            document.getElementById('co-text').textContent = t['co-text'];
            document.getElementById('co-btn').textContent = t['co-btn'];
            document.getElementById('receipt-title').textContent = t['receipt-title'];
            document.getElementById('receipt-done-btn').textContent = t['receipt-done-btn'];
        });

        // 【修改】網頁載入時，根據 savedScreen 恢復所有狀態
        window.addEventListener('load', function() {
            const savedScreen = localStorage.getItem('sunInnsCurrentScreen');
            const savedBookingId = localStorage.getItem('sunInnsCurrentBookingId');
            const savedTotal = localStorage.getItem('sunInnsConfirmationTotal');
            const savedDetail = localStorage.getItem('sunInnsConfirmationDetail');
            const savedReceipt = JSON.parse(localStorage.getItem('sunInnsLastReceipt'));

            if (savedScreen === 'screen-confirmation' && savedTotal) {
                document.getElementById('total-price').textContent = `RM${savedTotal}`;
                document.getElementById('price-detail').textContent = savedDetail;
                switchScreen('screen-confirmation');
            } 
            else if (savedScreen === 'screen-details' && savedBookingId) {
                const booking = bookings.find(b => b.id == savedBookingId);
                if (booking) {
                    displayDetails(booking);
                    switchScreen('screen-details');
                } else {
                    switchScreen('screen-welcome');
                }
            }
            else if (savedScreen === 'screen-receipt' && savedReceipt) {
                // 【修改】如果是在收據頁刷新，重新填滿收據內容
                document.getElementById('receipt-room').textContent = savedReceipt.room;
                document.getElementById('receipt-guest').textContent = savedReceipt.guest;
                document.getElementById('receipt-checkin').textContent = savedReceipt.checkin;
                document.getElementById('receipt-checkout').textContent = savedReceipt.checkout;
                document.getElementById('receipt-duration').textContent = savedReceipt.duration;
                document.getElementById('receipt-cost').textContent = savedReceipt.cost;
                document.getElementById('receipt-fee').textContent = savedReceipt.fee;
                document.getElementById('receipt-total').textContent = savedReceipt.total;
                switchScreen('screen-receipt');
            }
            else if (savedScreen === 'screen-admin') {
                // 【修改】如果是在 Admin 頁面刷新，重新執行 showAdminPanel 讓列表出現
                showAdminPanel();
            }
            else if (savedScreen && document.getElementById(savedScreen)) {
                switchScreen(savedScreen);
            } 
            else {
                switchScreen('screen-welcome');
            }
        });
    </script>
</body>
</html>
